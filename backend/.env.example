APP_NAME=MeetMind API
APP_ENV=development
DATABASE_PATH=storage/meetmind.db
STORAGE_ROOT=storage
MAX_UPLOAD_SIZE_BYTES=524288000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FILE_TIMEOUT_SECONDS=300
GEMINI_FILE_POLL_INTERVAL_SECONDS=2
AI_TIMEOUT_SECONDS=900
CV_TIMEOUT_SECONDS=1800
AI_PYTHON_EXECUTABLE=
CV_PYTHON_EXECUTABLE=
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
